{
  "name": "fbr-atl-checker",
  "version": "1.0.2",
  "description": "Desktop app that bulk-verifies Active Taxpayer List (ATL) status for CNIC/NTN numbers against Pakistan's FBR IRIS portal, straight from an Excel file.",
  "main": "main.js",
  "homepage": "https://github.com/ali-dev178/FBR-ATL-STATUS-CHECKER#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-dev178/FBR-ATL-STATUS-CHECKER.git"
  },
  "bugs": {
    "url": "https://github.com/ali-dev178/FBR-ATL-STATUS-CHECKER/issues"
  },
  "author": "Ali Muhammad (https://github.com/ali-dev178)",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "fbr",
    "iris",
    "atl",
    "active-taxpayer-list",
    "pakistan",
    "tax",
    "cnic",
    "ntn",
    "excel",
    "electron",
    "playwright",
    "automation",
    "ocr"
  ],
  "scripts": {
    "start": "electron .",
    "cli": "node automate.js",
    "sample": "node scripts/generate-sample.js",
    "icons": "node scripts/generate-icons.js",
    "screenshots": "node scripts/capture-screenshots.js",
    "browsers": "node scripts/install-bundled-chromium.js",
    "check": "node scripts/check.js",
    "pack": "npm run browsers && electron-builder --dir",
    "dist": "npm run browsers && electron-builder",
    "dist:win": "npm run browsers && electron-builder --win",
    "dist:mac": "npm run browsers && electron-builder --mac",
    "dist:linux": "npm run browsers && electron-builder --linux",
    "dist:all": "npm run browsers && electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.fbr.atl-checker",
    "productName": "FBR ATL Status Checker",
    "artifactName": "FBR-ATL-Status-Checker-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "engine/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/playwright/.local-browsers/**/*",
      "!node_modules/playwright-core/.local-browsers/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "browsers",
        "filter": [
          "chromium-*/**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "identity": null,
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "playwright": "^1.62.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
